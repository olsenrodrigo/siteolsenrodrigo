---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import { certifications, education, mit } from "../data/profile";
import { copy, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
---

<Base title={t.meta.formacao.title} description={t.meta.formacao.description} page="formacao" path="/formacao/" lang={lang}>
  <header class="page-head">
    <div class="wrap">
      <h1 data-i18n="formacao.title">{t.formacao.title}</h1>
      <p data-i18n="formacao.intro">{t.formacao.intro}</p>
    </div>
  </header>

  <section class="band" aria-labelledby="escolas">
    <div class="wrap">
      <h2 id="escolas" data-i18n="formacao.schools">{t.formacao.schools}</h2>
      <ol class="timeline">
        {education.map((item, index) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                <span data-i18n={`education.${index}.degree`}>{t.education[index].degree}</span>
              </h3>
              <p class="muted" data-i18n={`education.${index}.place`}>{t.education[index].place}</p>
            </div>
          </li>
        ))}
        <li>
          <div class="when">{mit.year}</div>
          <div>
            <h3 class="row-title">
              <span class="chip"><img src={mit.logo} alt="" /></span>
              {mit.name}
            </h3>
            <p class="muted" data-i18n="mit.place">{t.mit.place}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="band" style="padding-top: 0" aria-labelledby="certs">
    <div class="wrap">
      <h2 id="certs" data-i18n="formacao.certs">{t.formacao.certs}</h2>
      <p class="lead" data-i18n="formacao.certLead">{t.formacao.certLead}</p>
      <ul class="timeline">
        {certifications.map((item) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.name}
              </h3>
              <p class="muted">{item.place}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={t.faq.formacao} title={t.faq.formacaoTitle} titleKey="faq.formacaoTitle" prefix="faq.formacao" />
</Base>
