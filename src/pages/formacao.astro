---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import { certifications, education, faqFormacao, mit } from "../data/profile";

const title = "Formação e certificações de Olsen Rodrigo";
const description =
  "Informática Biomédica na USP Ribeirão Preto, MBA na FGV, CTO no Insper, PMP, Oracle Cloud, ITIL 4, PM3, AWS Cloud e o MIT CEO Summit 2026.";
---

<Base title={title} description={description} page="formacao" path="/formacao/">
  <header class="page-head">
    <div class="wrap">
      <h1>Formação</h1>
      <p>
        Três escolas, cinco certificações e, em outubro de 2026, uma sala em Boston
        para a qual ele foi selecionado. Conhecimento, para ele, não tem linha de chegada.
      </p>
    </div>
  </header>

  <section class="band" aria-labelledby="escolas">
    <div class="wrap">
      <h2 id="escolas">Escolas</h2>
      <ol class="timeline">
        {education.map((item) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.degree}
              </h3>
              <p class="muted">{item.place}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" style="padding-top: 0" aria-labelledby="certs">
    <div class="wrap">
      <h2 id="certs">Certificações</h2>
      <ul class="timeline">
        {certifications.map((item) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.name}
              </h3>
              <p class="muted">{item.place}</p>
            </div>
          </li>
        ))}
      </ul>

      <article class="feature">
        <span class="chip"><img src="/marcas/mit.svg" alt="MIT" /></span>
        <div>
          <h2>{mit.name}</h2>
          <p class="role" style="color:#8fd8d4">{mit.full}</p>
          <p>{mit.when}. {mit.where}.</p>
          <p>{mit.summary}</p>
          <p>As duas perguntas do programa:</p>
          <ul class="faculty">
            {mit.questions.map((question) => <li>{question}</li>)}
          </ul>
          <p>Corpo docente anunciado para a edição:</p>
          <ul class="faculty">
            {mit.faculty.map((person) => <li>{person}</li>)}
          </ul>
          <p>Agenda confirmada no material de julho de 2026:</p>
          <ul class="faculty">
            {mit.visits.map((visit) => <li>{visit}</li>)}
          </ul>
          <p>{mit.note}</p>
        </div>
      </article>
    </div>
  </section>

  <Faq items={faqFormacao} title="O que esta página afirma" />
</Base>
