---
import Base from "../layouts/Base.astro";
import Faq from "../components/Faq.astro";
import { certifications, education, faqFormacao, mit } from "../data/profile";

const title = "Formação e certificações de Olsen Rodrigo";
const description =
  "Informática Biomédica na USP Ribeirão Preto, MBA na FGV, CTO no Insper, PMP, Oracle Cloud, ITIL 4, PM3, AWS Cloud e o MIT CEO Summit 2026.";
---

<Base title={title} description={description} page="formacao" path="/formacao/">
  <header class="page-head">
    <div class="wrap">
      <h1>Formação</h1>
      <p>
        A certificação que organiza o resto é o PMP, desde 2016. As escolas explicam
        de onde ele veio. O projeto explica como ele trabalha.
      </p>
    </div>
  </header>

  <section class="band" aria-labelledby="escolas">
    <div class="wrap">
      <h2 id="escolas">Escolas</h2>
      <ol class="timeline">
        {education.map((item) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.degree}
              </h3>
              <p class="muted">{item.place}</p>
            </div>
          </li>
        ))}
        <li>
          <div class="when">{mit.year}</div>
          <div>
            <h3 class="row-title">
              <span class="chip"><img src={mit.logo} alt="" /></span>
              {mit.name}
            </h3>
            <p class="muted">{mit.place}</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="band" style="padding-top: 0" aria-labelledby="certs">
    <div class="wrap">
      <h2 id="certs">Certificações</h2>
      <p class="lead">
        PMP é Project Management Professional, a certificação do Project Management
        Institute. Desde 2016, mentoria, consultoria e produto passam por ela:
        escopo, risco, dono e a definição de pronto. O know-how é de saúde.
        O método serve em qualquer área.
      </p>
      <ul class="timeline">
        {certifications.map((item) => (
          <li>
            <div class="when">{item.year}</div>
            <div>
              <h3 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.name}
              </h3>
              <p class="muted">{item.place}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faqFormacao} title="O que esta página afirma" />
</Base>
