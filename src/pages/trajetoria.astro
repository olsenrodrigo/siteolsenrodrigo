---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { parallels, timeline, zummArticles, zummCategory } from "../data/profile";

const title = "Trajetória de Olsen Rodrigo | EAIOLSEN";
const description =
  "De 2004 à Sintetiza AI, e a coluna de tecnologia na Zumm: trechos dos textos assinados por Olsen Rodrigo no Portal Zumm.";
---

<Base title={title} description={description} page="trajetoria" path="/trajetoria/">
  <header class="page-head">
    <div class="wrap">
      <h1>Trajetória</h1>
      <p>
        A história não começa numa rede social. Começa num curso de informática
        em que ele não queria estar, e segue por sistemas em que parar não era opção.
      </p>
    </div>
  </header>

  <section class="band">
    <div class="wrap">
      <p class="lead">
        Olsen Rodrigo passou mais de 18 anos onde tecnologia e operação se encontram.
        O trecho longo é a Matrix, nos sistemas que processam 70 milhões de exames
        por mês. O trecho de liderança formal é a AmorSaúde Brasil, com mais de
        25 milhões de vidas impactadas. O trecho atual é a Sintetiza AI, empresa
        que ele fundou em dezembro de 2025. O fio dos três é projeto.
      </p>
      <ol class="timeline">
        {timeline.map((item) => (
          <li>
            <div class="when">{item.period}</div>
            <div>
              <h2 class="row-title">
                <span class="chip"><img src={item.logo} alt="" /></span>
                {item.href ? <a href={item.href}>{item.org}</a> : item.org}
              </h2>
              <p class="role">{item.role}</p>
              <p class="muted">{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band" style="padding-top: 0">
    <div class="wrap split">
      <figure class="frame">
        <Photo
          name="olsen-evento"
          alt="Olsen Rodrigo em pé, de braços cruzados, com crachá no peito em um evento."
          width={1200}
          height={1800}
        />
        <figcaption>Presença pública. O crachá leva o nome pelo qual o mercado o chama.</figcaption>
      </figure>
      <div>
        <h2>Em paralelo à cadeira</h2>
        <p class="lead">
          A coluna na Zumm coloca o nome na mídia mais importante de Ribeirão Preto,
          no impresso e no portal. O reconhecimento de Líder Destaque do Ano e os
          dois livros vêm da mesma rede em que ele é conselheiro.
        </p>
        <ul class="plain-list">
          {parallels.map((item) => (
            <li>
              <div class="when">{item.label}</div>
              <div>
                {"logo" in item && item.logo && (
                  <img class="mark" src={item.logo} alt="" />
                )}
                <p>
                  {item.detail}
                  {"href" in item && item.href && (
                    <> <a class="ink-link" href={item.href}>Editoria de Tecnologia</a></>
                  )}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="band band-alt" id="coluna" aria-labelledby="coluna-titulo">
    <div class="wrap">
      <h2 id="coluna-titulo">Na coluna da Zumm</h2>
      <p class="lead">
        Textos da editoria de Tecnologia do Portal Zumm, assinados por Olsen Rodrigo.
        A revista impressa segue no papel. A frase é o começo de cada texto.
      </p>
      <ul class="column-list">
        {zummArticles.map((item) => (
          <li>
            <div class="when">{item.date}</div>
            <div>
              <h3><a href={item.href}>{item.title}</a></h3>
              <p>{item.excerpt}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="note">
        <a class="ink-link" href={zummCategory}>Editoria de Tecnologia no Portal Zumm</a>
      </p>
    </div>
  </section>
</Base>
