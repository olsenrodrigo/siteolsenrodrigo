---
import Base from "../layouts/Base.astro";

const title = "Página não encontrada | Olsen Rodrigo";
const description = "Este endereço não existe no site de Olsen Rodrigo.";
---

<Base title={title} description={description} page="404" path="/404/" robots="noindex, follow">
  <section class="band missing">
    <div class="wrap">
      <h1>Este caminho não existe.</h1>
      <p class="lead">O endereço pode ter mudado. A página inicial continua no lugar.</p>
      <p><a class="ink-link" href="/">Voltar para o início</a></p>
    </div>
  </section>
</Base>
