---
import Base from "../layouts/Base.astro";
import { site, whatsappLink } from "../data/profile";

const title = "Contato de Olsen Rodrigo | EAIOLSEN";
const description =
  "Fale com Olsen Rodrigo sobre mentoria ou consultoria. WhatsApp, e-mail olsen@sintetiza.ai, Instagram @olsenrodrigo e LinkedIn. Ribeirão Preto, São Paulo.";
---

<Base title={title} description={description} page="contato" path="/contato/">
  <header class="page-head">
    <div class="wrap">
      <h1>Contato</h1>
      <p>
        Escreva a decisão que está em aberto. Uma frase basta para a primeira mensagem.
        Formato e investimento saem dessa conversa.
      </p>
    </div>
  </header>

  <section class="band">
    <div class="wrap">
      <ul class="contact-list">
        <li>
          <span>WhatsApp</span>
          <a href={whatsappLink("uma decisão")}>{site.whatsappDisplay}</a>
        </li>
        <li>
          <span>E-mail</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Instagram</span>
          <a href={site.instagram} rel="me">@olsenrodrigo</a>
        </li>
        <li>
          <span>LinkedIn</span>
          <a href={site.linkedin} rel="me">Olsen Rodrigo Mott Silva</a>
        </li>
        <li>
          <span>Empresa</span>
          <a href={site.sintetiza}>sintetiza.ai</a>
        </li>
        <li>
          <span>Onde</span>
          <span>{site.city}, {site.region}</span>
        </li>
      </ul>
    </div>
  </section>
</Base>
