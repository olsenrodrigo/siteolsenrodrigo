---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/profile";
import { copy, htmlLang, LANGS, localePath, metaKey, ogLocale, type Lang } from "../i18n";
import { jsonLd } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  page: string;
  path: string;
  lang?: Lang;
  ogType?: "website" | "profile";
  robots?: string;
}

const {
  title,
  description,
  page,
  path,
  lang = "pt",
  ogType = "website",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
} = Astro.props;

const t = copy(lang);
const key = metaKey(page);
const canonical = new URL(page === "404" ? "/404/" : localePath(lang, path), site.url).href;
const xDefault = new URL(path, site.url).href;
const alternates = LANGS.map((code) => ({
  hreflang: htmlLang[code],
  href: new URL(localePath(code, path), site.url).href,
}));
const json = jsonLd(page, lang);
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          if (path.indexOf("/404") !== -1) return;
          if (/^\/(en|es|zh)(\/|$)/.test(path)) return;
          var known = path === "/" || /^\/(trajetoria|formacao|mentoria|consultoria|contato)\/?$/.test(path);
          if (!known) return;
          var stored = localStorage.getItem("eaiolsen-lang");
          if (stored !== "en" && stored !== "es" && stored !== "zh") return;
          location.replace("/" + stored + (path === "/" ? "/" : path) + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n={`meta.${key}.title`}>{title}</title>
    <meta name="description" content={description} data-i18n-content={`meta.${key}.description`} />
    <meta name="author" content={site.fullName} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {page !== "404" && alternates.map((item) => <link rel="alternate" hreflang={item.hreflang} href={item.href} />)}
    {page !== "404" && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#063246" />
    <meta name="geo.region" content="BR-SP" />
    <meta name="geo.placename" content="Ribeirão Preto" />
    <meta property="og:site_name" content={`${site.name} — ${site.brand}`} />
    <meta property="og:type" content={ogType} />
    {ogType === "profile" && (
      <>
        <meta property="profile:first_name" content="Olsen" />
        <meta property="profile:last_name" content="Rodrigo" />
      </>
    )}
    <meta property="og:locale" content={ogLocale[lang]} />
    {LANGS.filter((code) => code !== lang).map((code) => (
      <meta property="og:locale:alternate" content={ogLocale[code]} />
    ))}
    <meta property="og:title" content={title} data-i18n-content={`meta.${key}.title`} />
    <meta property="og:description" content={description} data-i18n-content={`meta.${key}.description`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.chrome.ogAlt} data-i18n-content="chrome.ogAlt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} data-i18n-content={`meta.${key}.title`} />
    <meta name="twitter:description" content={description} data-i18n-content={`meta.${key}.description`} />
    <meta name="twitter:image" content={site.ogImage} />
    <script type="application/ld+json" set:html={json} />
  </head>
  <body data-lang={lang} data-page={page} data-path={path} data-no-route={page === "404" ? "1" : undefined}>
    <a class="skip" href="#conteudo" data-i18n="chrome.skip">{t.chrome.skip}</a>
    <Header lang={lang} path={path} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/i18n-client";
    </script>
  </body>
</html>
