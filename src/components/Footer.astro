---
import { site } from "../data/profile";
import { copy, localePath, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div>
      <a href={localePath(lang, "/")} data-locale-href="/">{site.brand}</a>
      <small>{site.city}, {site.region}. <span data-i18n="chrome.country">{t.chrome.country}</span>.</small>
    </div>
    <ul class="footer-links">
      <li><a href={site.instagram} rel="me">Instagram @olsenrodrigo</a></li>
      <li><a href={site.instagramCompany}>Instagram @sintetizaai</a></li>
      <li><a href={site.linkedin} rel="me">LinkedIn</a></li>
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
    <div>
      <small>© {year} {site.name}</small>
    </div>
  </div>
</footer>
