---
interface Props {
  name: string;
  alt: string;
  altKey?: string;
  width: number;
  height: number;
  priority?: boolean;
}

const { name, alt, altKey, width, height, priority = false } = Astro.props;
---

<picture>
  <source srcset={`/fotos/${name}.webp`} type="image/webp" />
  <img
    src={`/fotos/${name}.jpg`}
    alt={alt}
    data-i18n-alt={altKey}
    width={width}
    height={height}
    loading={priority ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={priority ? "high" : "auto"}
  />
</picture>
