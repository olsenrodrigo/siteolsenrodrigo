---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  title: string;
  titleKey: string;
  prefix: string;
}

const { items, title, titleKey, prefix } = Astro.props;
---

<section class="band" aria-labelledby="faq-titulo">
  <div class="wrap">
    <h2 id="faq-titulo" data-i18n={titleKey}>{title}</h2>
    <div class="qa">
      {items.map((item, index) => (
        <article>
          <h3 data-i18n={`${prefix}.${index}.q`}>{item.q}</h3>
          <p data-i18n={`${prefix}.${index}.a`}>{item.a}</p>
        </article>
      ))}
    </div>
  </div>
</section>
